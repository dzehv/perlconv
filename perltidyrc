# .perltidyrc
# configuration matches emacs cperl-mode settings
# (tabs, width 8, cuddled else)

# ----------------------------------------------------------------------
# indentation and formatting
# ----------------------------------------------------------------------

# use hard tabs instead of spaces (matches indent-tabs-mode t)
--entab-leading-whitespace=8

# set indentation width to 8 columns (matches standard-indent 8)
--indent-columns=8

# set tab width to 8 spaces (matches tab-width 8)
--default-tabsize=8

# ----------------------------------------------------------------------
# code style and structure
# ----------------------------------------------------------------------

# merge else with closing brace (matches cperl-merge-trailing-else t)
# example: } else {
--cuddled-else

# line length limit (standard for terminals)
# with 8-char tabs this might feel tight, consider 100 if needed
--maximum-line-length=80

# ----------------------------------------------------------------------
# parentheses and blocks
# ----------------------------------------------------------------------

# tighten parentheses to look more block-like
# (matches logic of cperl-indent-parens-as-block t)
--paren-tightness=2

# do not put space before semicolon
--no-space-for-semicolon

# do not outdent long quotes, keep them aligned
--no-outdent-long-quotes
