# This is a simple of a .perltidyrc configuration file using in CWW project
# Setting for Perl Convention Layer 1 & Layer 2
# See detalied information on:
# https://intranet.comodo.net/pages/viewpage.action?spaceKey=DEV&title=Perl+Code+Conventions

# The first of all STYLE
--perl-best-practices

#I/O control
--nostandard-output
--nostandard-error-output
--backup-and-modify-in-place
--backup-file-extension=.untidy

#FORMATTING OPTIONS
#Basic Options
--indent-columns=4
#--maximum-line-length=80

#Code Indentation Control
--continuation-indentation=2
--nooutdent-long-quotes
--nooutdent-labels
--nooutdent-keywords

#Whitespace Control
--paren-tightness=2
--square-bracket-tightness=1
--brace-tightness=1
--block-brace-tightness=0

--tight-secret-operators
--nospace-for-semicolon
--nospace-terminal-semicolon
--noadd-semicolons

--nospace-after-keyword="my local our"
--trim-qw

#Comment Controls
--nooutdent-long-comments
--minimum-space-to-comment=1
--ignore-side-comment-lengths

--closing-side-comments
--closing-side-comment-interval=10
--closing-side-comment-prefix="# end"
--closing-side-comment-maximum-text=20

--static-block-comments
--static-block-comment-prefix=^#{2,}[^\s#]

--static-side-comments

#Skipping Selected Sections of Code
--format-skipping
--format-skipping-begin='#<<<'
--format-skipping-end='#>>>'

#Line Break Control
--nocuddled-else
--noopening-brace-on-new-line
--opening-brace-always-on-right

--opening-token-right
--opening-paren-right
--opening-hash-brace-right
--opening-square-bracket-right
#--weld-nested-containers
--stack-opening-tokens
--stack-opening-paren
--stack-opening-hash-brace
--stack-opening-square-bracket
--stack-opening-block-brace
