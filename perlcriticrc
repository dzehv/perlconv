# .perlcriticrc
# maintained layout and security rules, ignoring cuddled else conflicts

# ----------------------------------------------------------------------
# global configuration
# ----------------------------------------------------------------------

severity = 3
verbose = [%p] %m at line %l, column %c.\n

# ----------------------------------------------------------------------
# exclusions (allow your coding style)
# ----------------------------------------------------------------------

# disable complaints about cuddled else
[-ControlStructures::ProhibitCuddledElse]

# allow postfix controls like if/unless at the end of a line
[-ControlStructures::ProhibitPostfixControls]

# allow string eval for legacy compatibility
[-BuiltInFunctions::ProhibitStringEval]

# ----------------------------------------------------------------------
# layout & formatting
# ----------------------------------------------------------------------

# codelayout::prohibithardtabs is active by default to ban tabs

# prohibit trailing whitespace at the end of lines
[CodeLayout::ProhibitTrailingWhitespace]

# ----------------------------------------------------------------------
# inclusions & tuning (bugs and security)
# ----------------------------------------------------------------------

[TestingAndDebugging::RequireUseStrict]
severity = 5

[TestingAndDebugging::RequireUseWarnings]
severity = 5

# prevent unsafe two-argument open calls
[InputOutput::ProhibitTwoArgOpen]
severity = 5

# complexity limits tuned for legacy codebases
[Subroutines::ProhibitExcessComplexity]
max_mccabe = 25

[Subroutines::ProhibitManyArgs]
max_arguments = 8
